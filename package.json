{
  "name": "@feryardiant/sendgrid-inbound-parser",
  "type": "module",
  "version": "0.1.9",
  "packageManager": "pnpm@11.9.0",
  "description": "Simple library to parse SendGrid Inbound Mail",
  "author": "Fery Wardiyanto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/feryardiant/sendgrid-inbound-parser.git"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome check",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "@types/busboy": "^1.5.0",
    "@types/express": "^5.0.0",
    "@types/mailparser": "^3.4.0",
    "express": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@types/busboy": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "@types/mailparser": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "mailparser": "^3.9.37"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/busboy": "^1.5.5",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "bumpp": "^12.3.0",
    "express": "^5.3.0",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "supertest": "^7.3.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit $1",
    "pre-commit": "pnpm exec lint-staged --allow-empty"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
